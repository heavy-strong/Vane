# Copy this file to .env and set only the services you use.
# .env is ignored by Git and must never be committed.

# OpenRouter: automatically creates an OpenRouter connection at startup.
OPENROUTER_API_KEY=

# Other optional model providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional search backend URL.
SEARXNG_API_URL=http://localhost:8889
