{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Bundled settings page. Remote access is granted separately only for shortcut commands.",
  "windows": ["main", "settings"],
  "permissions": [
    "core:default",
    "allow-get-settings",
    "allow-save-settings",
    "allow-set-shortcut-recording"
  ]
}
