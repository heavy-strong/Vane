{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vane",
  "version": "0.1.0",
  "identifier": "app.vane.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Vane desktop shell",
    "longDescription": "Summon your self-hosted Vane instance from anywhere with a global keyboard shortcut.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
